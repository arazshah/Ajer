{
  "name": "ajer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:operational": "tsx scripts/operational-smoke.ts",
    "test:crm": "tsx scripts/crm-smoke.ts",
    "test:operations": "tsx scripts/sales-operations-smoke.ts",
    "test:accounting": "tsx scripts/accounting-smoke.ts",
    "test:legal": "tsx scripts/legal-contract-smoke.ts",
    "test:security": "tsx scripts/security-smoke.ts",
    "test:integrations": "tsx scripts/integration-smoke.ts",
    "test:warm": "tsx scripts/warm-test.ts",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:dev:up": "docker-compose -f docker-compose.yaml -f docker-compose.dev.yml up -d postgres",
    "db:dev:stop": "docker-compose -f docker-compose.yaml -f docker-compose.dev.yml stop postgres"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "jose": "6.1.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.54.2",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.0",
    "prisma": "6.12.0",
    "sonner": "2.0.1",
    "tsx": "4.23.12",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.16",
    "@types/node": "22.10.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.23",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
